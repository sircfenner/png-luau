{
    "bundle": {
        "modules_identifier": "__BUNDLE",
        "require_mode": {
            "name": "luau"
        }
    },
    "rules": [
        {
            "rule": "remove_comments",
            "except": ["^-- selene", "^-- stylua"]
        },
        "remove_unused_variable",
        {
            "rule": "append_text_comment",
            "text": "!optimize 2"
        },
        {
            "rule": "append_text_comment",
            "text": "!native"
        },
        {
            "rule": "append_text_comment",
            "text": "!strict"
        }
    ]
}
